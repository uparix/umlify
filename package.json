{
  "name": "umlify",
  "private": true,
  "description": "Live, read-only browser viewer for umlviewer IR files, in the style of archify.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node packages/server/src/cli.ts",
    "dev": "node packages/server/src/cli.ts --dev examples/uml-viewer.edn",
    "dev:web": "npm run dev -w @umlify/web",
    "build": "npm run build -w @umlify/web",
    "typecheck": "tsc -p packages/core && tsc -p packages/server && tsc -p packages/web && tsc -p e2e",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
